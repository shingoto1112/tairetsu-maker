# Supabase public browser settings for cloud collaboration.
# Use the anon public key or the newer publishable key.
# Do not put service_role keys in frontend env files.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloud saving and collaboration are built in only when this is exactly 1.
# Left empty (the default), the app is device-only and never contacts Supabase.
VITE_COLLABORATION_V2=

# Optional public URLs (not secrets). Empty = the production site.
# Base of invitation links (must be an origin the Edge functions allow).
VITE_COLLABORATION_INVITATION_URL=
# Site that serves privacy.html, terms.html and support.html.
VITE_PUBLIC_SITE_URL=
